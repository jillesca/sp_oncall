# ── Required ──────────────────────────────────────────────────────────────────

OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sp_oncall
LANGSMITH_TRACING=true

# ── SP Oncall settings ────────────────────────────────────────────────────────

# Log level for sp_oncall modules (debug | info | warning | error)
SP_ONCALL_LOG_LEVEL=info

# Maximum number of execution retries per device investigation (default: 3)
SP_ONCALL_MAX_RETRIES=3

# Set to true to skip live gNMI calls and return mock data (not yet implemented)
# SP_ONCALL_DRY_RUN=false

# ── LangChain / LangGraph ─────────────────────────────────────────────────────

# Enable verbose LangChain debug tracing
# SP_ONCALL_LANGCHAIN_DEBUG=false

# Per-module log overrides (e.g. sp_oncall.nodes=debug,langgraph=error)
# SP_ONCALL_MODULE_LEVELS=

# Write structured JSON logs to a file (leave empty to log to stdout only)
# SP_ONCALL_LOG_FILE=

# Suppression mode for noisy external libraries (langgraph | none)
# SP_ONCALL_EXTERNAL_SUPPRESSION_MODE=langgraph
