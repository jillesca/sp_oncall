# ── Required ──────────────────────────────────────────────────────────────────

OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sp_oncall
LANGSMITH_TRACING=true

# ── SP Oncall settings ────────────────────────────────────────────────────────

# Log level for sp_oncall modules (debug | info | warning | error)
SP_ONCALL_LOG_LEVEL=info

# Maximum number of execution retries per device investigation (default: 3)
SP_ONCALL_MAX_RETRIES=3

# Fast model used for structured output parsing — cheaper/faster than the main model
SP_ONCALL_FAST_MODEL=openai/gpt-4o-mini

# Set to true to skip live gNMI calls and return mock data (not yet implemented)
# SP_ONCALL_DRY_RUN=false

# ── Webhook proxy (optional, `make webhook`) ──────────────────────────────────
# Only these keys are read from this file by the Makefile; the container never
# receives the rest of it (API keys above stay out of the container).

# Host port of the webhook proxy. Alertmanager in the observability stack posts
# to http://host.docker.internal:8080/alert by default.
# WEBHOOK_PORT=8080

# Host address the proxy is published on. Loopback by default because the
# endpoint is unauthenticated and triggers LLM runs. Linux Docker needs 0.0.0.0
# (the host gateway is not loopback): anyone who can reach the port can start
# investigations, so firewall it.
# WEBHOOK_BIND=127.0.0.1

# Address `make run` binds LangGraph to (--host). The webhook container reaches
# it at http://host.docker.internal:2024. Linux Docker needs 0.0.0.0, which
# exposes the agent API on your network.
# LANGGRAPH_HOST=127.0.0.1

# ── OpenRouter (optional) ─────────────────────────────────────────────────────

# Required only when using openrouter/* models (e.g. openrouter/anthropic/claude-sonnet-4)
# OPENROUTER_API_KEY=

# ── LangChain / LangGraph ─────────────────────────────────────────────────────

# Enable verbose LangChain debug tracing
# SP_ONCALL_LANGCHAIN_DEBUG=false

# Per-module log overrides (e.g. sp_oncall.nodes=debug,langgraph=error)
# SP_ONCALL_MODULE_LEVELS=

# Write structured JSON logs to a file (leave empty to log to stdout only)
# SP_ONCALL_LOG_FILE=

# Suppression mode for noisy external libraries (langgraph | none)
# SP_ONCALL_EXTERNAL_SUPPRESSION_MODE=langgraph
